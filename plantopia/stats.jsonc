{
    // Statistics for the table
    "table": {
        // One round = one completed Planting Phase + one completed
        // Weather Phase. Incremented once per round, at the end of
        // WeatherPhaseGrow (whether the game continues or this round
        // ends the game). Per https://trello.com/c/7kdTOK4l.
        "total_rounds": {
            "id": 10,
            "name": "Total rounds",
            "type": "int"
        }
    },

    // Statistics for each player — matches the at-a-glance player panel
    // (Game.js computePlayerStats()/renderPlayerPanel()) exactly: hand
    // count, Bonus Weather cards held by type, and garden plant counts by
    // family and maturity. Updated once per round alongside total_rounds
    // (see Game::updatePlayerPanelStats()). Per https://trello.com/c/7kdTOK4l.
    "player": {
        // End-game score breakdown (Trello bbJp2j8q). Defined first so they
        // appear at the top of the end-game stats table; the three cross-
        // family totals lead, then the per-family breakdown.
        "total_baby_score":   { "id": 42, "name": "Total Plant Score from Baby Plants",   "type": "int" },
        "total_adult_score":  { "id": 43, "name": "Total Plant Score from Adult Plants",  "type": "int" },
        "total_bonus_score":  { "id": 44, "name": "Total Bonus Score",                    "type": "int" },
        "tree_baby_score":    { "id": 30, "name": "Tree — Baby Plant Score",  "type": "int" },
        "tree_adult_score":   { "id": 31, "name": "Tree — Adult Plant Score", "type": "int" },
        "tree_bonus_score":   { "id": 32, "name": "Tree — Bonus Score",       "type": "int" },
        "tree_total_score":   { "id": 33, "name": "Tree — Total Score",       "type": "int" },
        "flower_baby_score":  { "id": 34, "name": "Flower — Baby Plant Score",  "type": "int" },
        "flower_adult_score": { "id": 35, "name": "Flower — Adult Plant Score", "type": "int" },
        "flower_bonus_score": { "id": 36, "name": "Flower — Bonus Score",       "type": "int" },
        "flower_total_score": { "id": 37, "name": "Flower — Total Score",       "type": "int" },
        "cactus_baby_score":  { "id": 38, "name": "Cactus — Baby Plant Score",  "type": "int" },
        "cactus_adult_score": { "id": 39, "name": "Cactus — Adult Plant Score", "type": "int" },
        "cactus_bonus_score": { "id": 40, "name": "Cactus — Bonus Score",       "type": "int" },
        "cactus_total_score": { "id": 41, "name": "Cactus — Total Score",       "type": "int" },
        "hand_count": {
            "id": 20,
            "name": "Cards in hand",
            "type": "int"
        },
        "bonus_weather_sun": {
            "id": 21,
            "name": "Bonus Sun cards held",
            "type": "int"
        },
        "bonus_weather_rain": {
            "id": 22,
            "name": "Bonus Rain cards held",
            "type": "int"
        },
        "bonus_weather_wind": {
            "id": 23,
            "name": "Bonus Wind cards held",
            "type": "int"
        },
        "baby_cactus_count": {
            "id": 24,
            "name": "Baby Cactus in garden",
            "type": "int"
        },
        "adult_cactus_count": {
            "id": 25,
            "name": "Adult Cactus in garden",
            "type": "int"
        },
        "baby_flower_count": {
            "id": 26,
            "name": "Baby Flower in garden",
            "type": "int"
        },
        "adult_flower_count": {
            "id": 27,
            "name": "Adult Flower in garden",
            "type": "int"
        },
        "baby_tree_count": {
            "id": 28,
            "name": "Baby Tree in garden",
            "type": "int"
        },
        "adult_tree_count": {
            "id": 29,
            "name": "Adult Tree in garden",
            "type": "int"
        }
    }
}
